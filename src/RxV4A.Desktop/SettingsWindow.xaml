<Window x:Class="RxV4A.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:RxV4A.Host.Localization;assembly=RxV4A.Host"
        mc:Ignorable="d"
        Title="{x:Static loc:Strings.Settings_Title}" Height="860" Width="820"
        Icon="Assets/NAVA.ico"
        MinHeight="680" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
        <StackPanel>
            <TextBlock Text="{x:Static loc:Strings.Settings_Heading}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.Settings_Subtitle}" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Settings_Connection}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConnectionText" Text="{x:Static loc:Strings.Status_Disconnected}" />
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Settings_Device}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Settings_Power}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PowerText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.Settings_InputVolume}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PlaybackText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.Settings_LastUpdate}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UpdatedText" Text="—" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <StackPanel Margin="0,16,0,0">
            <TextBlock x:Name="BlockerWarningText" Visibility="Collapsed" Foreground="#C62828"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="PowerOnButton" Content="{x:Static loc:Strings.Settings_AmpOn}" Height="48" Margin="0,0,8,0"
                        Click="PowerOnButton_Click" />
                <Button x:Name="StandbyButton" Content="{x:Static loc:Strings.Settings_Standby}" Height="48" Margin="8,0,0,0"
                        Click="StandbyButton_Click" />
            </UniformGrid>
            <Button Content="{x:Static loc:Strings.Settings_Refresh}" MinWidth="160" Height="32" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,0"
                    Click="RefreshButton_Click" />
        </StackPanel>

        <Border x:Name="DailyControlsPanel" BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Settings_Daily}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="OperationStatusText" Visibility="Collapsed" Foreground="#00897B"
                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

                <Grid x:Name="InputPanel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Source}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="InputComboBox" Height="30" />
                    <Button Grid.Column="2" x:Name="SetInputButton" Content="{x:Static loc:Strings.Settings_Switch}" Margin="10,0,0,0"
                            Click="SetInputButton_Click" />
                </Grid>

                <Grid x:Name="VolumePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Volume}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="VolumeSlider" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickPlacement="None"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" x:Name="VolumeValueText" Text="—" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Grid.Column="3" x:Name="SetVolumeButton" Content="{x:Static loc:Strings.Settings_Apply}" Margin="10,0,0,0"
                            Click="SetVolumeButton_Click" />
                </Grid>

                <Grid x:Name="MutePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Mute}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="MuteCheckBox" Content="{x:Static loc:Strings.Settings_Enabled}"
                              Click="MuteCheckBox_Click" />
                </Grid>

                <Grid x:Name="SoundProgramPanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_SoundProgram}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1" x:Name="SoundProgramComboBox" Height="30" />
                    <Button Grid.Column="2" x:Name="SetSoundProgramButton" Content="{x:Static loc:Strings.Settings_Apply}" Margin="10,0,0,0"
                            Click="SetSoundProgramButton_Click" />
                </Grid>

                <WrapPanel x:Name="ProcessingPanel" Margin="0,12,0,0">
                    <CheckBox x:Name="Surround3dCheckBox" Content="3D Surround" Margin="0,0,18,8"
                              Click="Surround3dCheckBox_Click" />
                    <CheckBox x:Name="DirectCheckBox" Content="Direct" Margin="0,0,18,8"
                              Click="DirectCheckBox_Click" />
                    <CheckBox x:Name="PureDirectCheckBox" Content="Pure Direct" Margin="0,0,18,8"
                              Click="PureDirectCheckBox_Click" />
                    <CheckBox x:Name="EnhancerCheckBox" Content="Enhancer" Margin="0,0,18,8"
                              Click="EnhancerCheckBox_Click" />
                </WrapPanel>

                <Grid x:Name="TonePanel" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Tone}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="ToneModeComboBox" Height="30" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" x:Name="BassTextBox" Height="30" Margin="0,0,8,0"
                             ToolTip="{x:Static loc:Strings.Settings_BassTooltip}" VerticalContentAlignment="Center" />
                    <TextBox Grid.Column="3" x:Name="TrebleTextBox" Height="30" Margin="0,0,8,0"
                             ToolTip="{x:Static loc:Strings.Settings_TrebleTooltip}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="4" Content="{x:Static loc:Strings.Settings_Apply}" Click="SetToneButton_Click" />
                </Grid>

                <Grid x:Name="EqualizerPanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EQ" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="EqualizerModeComboBox" Height="30" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" x:Name="EqualizerLowTextBox" Height="30" Margin="0,0,8,0"
                             ToolTip="{x:Static loc:Strings.Settings_LowTooltip}" VerticalContentAlignment="Center" />
                    <TextBox Grid.Column="3" x:Name="EqualizerMidTextBox" Height="30" Margin="0,0,8,0"
                             ToolTip="{x:Static loc:Strings.Settings_MidTooltip}" VerticalContentAlignment="Center" />
                    <TextBox Grid.Column="4" x:Name="EqualizerHighTextBox" Height="30" Margin="0,0,8,0"
                             ToolTip="{x:Static loc:Strings.Settings_HighTooltip}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="5" Content="{x:Static loc:Strings.Settings_Apply}" Click="SetEqualizerButton_Click" />
                </Grid>

                <Grid x:Name="BalancePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Balance}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="BalanceTextBox" Height="30"
                             ToolTip="{x:Static loc:Strings.Settings_BalanceTooltip}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="{x:Static loc:Strings.Settings_Apply}" Margin="10,0,0,0"
                            Click="SetBalanceButton_Click" />
                </Grid>

                <TextBlock x:Name="CapabilityNoteText" Foreground="Gray" Margin="0,12,0,0"
                           Text="{x:Static loc:Strings.Settings_CapabilityNote}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Settings_Target}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_TargetHelp}"
                           Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:Strings.Settings_Nic}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="DiscoveryNetworkInterfaceComboBox"
                              Height="30" DisplayMemberPath="Label" />
                </Grid>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Settings_SaveConnect}" MinWidth="200" Padding="12,0" Margin="12,0,0,0"
                            Click="SaveHostButton_Click" />
                    <TextBox x:Name="ManualHostTextBox" Height="30" VerticalContentAlignment="Center" />
                </DockPanel>
                <Separator Margin="0,16,0,12" />
                <TextBlock Text="{x:Static loc:Strings.Settings_Behavior}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_Language}" Margin="0,12,0,0" />
                <ComboBox x:Name="LanguageComboBox" Height="30" Margin="0,6,0,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged" />
                <TextBlock x:Name="LanguageStatusText" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="MinimizeToTrayCheckBox"
                          Content="{x:Static loc:Strings.Settings_MinimizeToTray}"
                          Margin="0,9,0,0"
                          Click="MinimizeToTrayCheckBox_Click" />
                <TextBlock x:Name="MinimizeBehaviorStatusText"
                           Foreground="Gray" Margin="22,4,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="ShowCompactPowerOnStartupCheckBox"
                          Content="{x:Static loc:Strings.Settings_ShowCompactOnStartup}"
                          Margin="0,12,0,0"
                          Click="ShowCompactPowerOnStartupCheckBox_Click" />
                <TextBlock x:Name="CompactPowerStartupStatusText"
                           Foreground="Gray" Margin="22,4,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="{x:Static loc:Strings.Settings_StartWithWindows}"
                          Margin="0,12,0,0"
                          Click="StartWithWindowsCheckBox_Click" />
                <TextBlock x:Name="StartWithWindowsStatusText"
                           Foreground="Gray" Margin="22,4,0,0" TextWrapping="Wrap" />
                <Separator Margin="0,16,0,12" />
                <TextBlock Text="{x:Static loc:Strings.Settings_Hotkeys}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="HotkeyStatusText"
                           Text="{x:Static loc:Strings.Settings_HotkeysPreparing}"
                           Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:Strings.Settings_HotkeyDefaults}"
                           Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Button Content="{x:Static loc:Strings.Settings_HotkeyDetails}" MinWidth="170" Padding="12,0" Height="32" HorizontalAlignment="Right"
                        Margin="0,10,0,0" Click="OpenSettingsButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.Settings_LocalApi}"
                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
