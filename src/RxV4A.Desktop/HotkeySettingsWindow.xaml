<Window x:Class="RxV4A.Desktop.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RxV4A.Host.Localization;assembly=RxV4A.Host"
        Title="{x:Static loc:Strings.Hotkey_Title}" Height="620" Width="940"
        Icon="Assets/NAVA.ico"
        MinHeight="520" MinWidth="820" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Hotkey_Save}" Width="120" Height="32" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="{x:Static loc:Strings.Hotkey_Close}" Width="100" Height="32" Click="CloseButton_Click" />
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{x:Static loc:Strings.Hotkey_HelpKeys}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:Strings.Hotkey_HelpAmount}"
                           Foreground="Gray" Margin="0,4,0,8" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="{x:Static loc:Strings.Hotkey_Add}" Padding="12,5" Margin="0,0,6,0" Click="AddHotkeyButton_Click" />
                    <Button Content="{x:Static loc:Strings.Hotkey_Remove}" Padding="12,5" Margin="0,0,6,0" Click="RemoveHotkeyButton_Click" />
                    <Button Content="{x:Static loc:Strings.Hotkey_Reset}" Padding="12,5" Margin="0,0,12,0" Click="ResetHotkeysButton_Click" />
                    <Button Content="{x:Static loc:Strings.Hotkey_Capture}" Padding="12,5" Click="CaptureGlobalButton_Click" />
                    <TextBlock x:Name="CaptureStatusText" Margin="12,6,0,0" Foreground="DarkOrange" />
                </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="GlobalHotkeysGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" ItemsSource="{Binding GlobalHotkeys}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static loc:Strings.Hotkey_ColKey}" Width="165">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="VirtualKey"
                                          SelectedValue="{Binding VirtualKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinWidth="140" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Ctrl" Binding="{Binding Ctrl}" Width="60" />
                    <DataGridCheckBoxColumn Header="Alt" Binding="{Binding Alt}" Width="60" />
                    <DataGridCheckBoxColumn Header="Shift" Binding="{Binding Shift}" Width="60" />
                    <DataGridTemplateColumn Header="{x:Static loc:Strings.Hotkey_ColAction}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          SelectedValue="{Binding ActionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinWidth="250" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Strings.Hotkey_ColAmount}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding RequiresAmount}" HorizontalContentAlignment="Right"
                                         ToolTip="{x:Static loc:Strings.Hotkey_AmountTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
