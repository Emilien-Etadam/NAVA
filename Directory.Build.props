<Project>
  <PropertyGroup>
    <Authors>anko</Authors>
    <Company>anko</Company>
    <Product>NAVA</Product>
    <Title>NAVA</Title>
    <Description>French-localized fork of NAVA, a Windows controller for Yamaha Extended Control amplifiers. Original work by anko.</Description>
    <Copyright>Copyright (c) 2026 anko</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Emilien-Etadam/NAVA</RepositoryUrl>
    <NeutralLanguage>fr</NeutralLanguage>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>fr.1</VersionSuffix>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
